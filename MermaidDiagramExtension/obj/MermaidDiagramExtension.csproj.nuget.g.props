    <Import Project="$(NuGetPackageRoot)microsoft.codeanalysis.bannedapianalyzers\3.3.2\build\Microsoft.CodeAnalysis.BannedApiAnalyzers.props" Condition="Exists('$(NuGetPackageRoot)microsoft.codeanalysis.bannedapianalyzers\3.3.2\build\Microsoft.CodeAnalysis.BannedApiAnalyzers.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.codeanalysis.analyzers\3.3.4\buildTransitive\Microsoft.CodeAnalysis.Analyzers.props" Condition="Exists('$(NuGetPackageRoot)microsoft.codeanalysis.analyzers\3.3.4\buildTransitive\Microsoft.CodeAnalysis.Analyzers.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgMicrosoft_VisualStudio_Threading_Analyzers Condition=" '$(PkgMicrosoft_VisualStudio_Threading_Analyzers)' == '' ">C:\Users\windo\.nuget\packages\microsoft.visualstudio.threading.analyzers\17.8.14</PkgMicrosoft_VisualStudio_Threading_Analyzers>
    <PkgMicrosoft_Web_WebView2 Condition=" '$(PkgMicrosoft_Web_WebView2)' == '' ">C:\Users\windo\.nuget\packages\microsoft.web.webview2\1.0.2651.64</PkgMicrosoft_Web_WebView2>
    <PkgMicrosoft_VsSDK_CompatibilityAnalyzer Condition=" '$(PkgMicrosoft_VsSDK_CompatibilityAnalyzer)' == '' ">C:\Users\windo\.nuget\packages\microsoft.vssdk.compatibilityanalyzer\17.10.2178</PkgMicrosoft_VsSDK_CompatibilityAnalyzer>
    <PkgMicrosoft_VisualStudio_SDK_Analyzers Condition=" '$(PkgMicrosoft_VisualStudio_SDK_Analyzers)' == '' ">C:\Users\windo\.nuget\packages\microsoft.visualstudio.sdk.analyzers\17.7.22</PkgMicrosoft_VisualStudio_SDK_Analyzers>
    <PkgMicrosoft_VSSDK_BuildTools Condition=" '$(PkgMicrosoft_VSSDK_BuildTools)' == '' ">C:\Users\windo\.nuget\packages\microsoft.vssdk.buildtools\17.10.2178</PkgMicrosoft_VSSDK_BuildTools>
    <PkgMicrosoft_VisualStudio_Composition_Analyzers Condition=" '$(PkgMicrosoft_VisualStudio_Composition_Analyzers)' == '' ">C:\Users\windo\.nuget\packages\microsoft.visualstudio.composition.analyzers\17.7.26</PkgMicrosoft_VisualStudio_Composition_Analyzers>
    <PkgMicrosoft_ServiceHub_Analyzers Condition=" '$(PkgMicrosoft_ServiceHub_Analyzers)' == '' ">C:\Users\windo\.nuget\packages\microsoft.servicehub.analyzers\4.4.16</PkgMicrosoft_ServiceHub_Analyzers>
